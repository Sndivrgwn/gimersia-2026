func test_seeded_zones_match_golden() -> void:
	assert_eq(ZONE_DIGITS.length(), ZONE_SAMPLE_COUNT, "literal golden harus lengkap")
	var local_rng := RandomNumberGenerator.new()
	local_rng.seed = ZONE_SEED
	var mismatches := PackedInt32Array()
	for index in ZONE_SAMPLE_COUNT:
		var point := Vector2(
			local_rng.randf_range(-2600.0, 2600.0),
			local_rng.randf_range(-2600.0, 2600.0)
		)
		var expected := ZONE_DIGITS.unicode_at(index) - 48
		var actual := int(IslandZones.zone_at(point))
		if actual != expected:
			mismatches.append(index)
	assert_true(mismatches.is_empty(), "zone_at berubah di %d titik: %s" % [
		mismatches.size(), str(mismatches.slice(0, mini(5, mismatches.size())))
	])


func test_boundary_points_match_golden() -> void:
	assert_eq(BOUNDARY_POINTS.size(), BOUNDARY_ZONES.size())
	for index in BOUNDARY_POINTS.size():
		assert_eq(
			int(IslandZones.zone_at(BOUNDARY_POINTS[index])),
			BOUNDARY_ZONES[index],
			"batas #%d %s" % [index, str(BOUNDARY_POINTS[index])]
		)


func test_base_site_rules_table_matches_golden() -> void:
	assert_eq(SITE_CENTERS.size(), 60, "tabel 60 sampel")
	for index in SITE_CENTERS.size():
		var center := SITE_CENTERS[index]
		var result := BaseSiteRules.evaluate(center, null)
		assert_eq(bool(result["valid"]), SITE_VALID[index], "valid #%d %s" % [index, str(center)])
		assert_eq(String(result["reason"]), SITE_REASONS[index], "reason #%d %s" % [index, str(center)])


func test_poi_constants_match_golden() -> void:
	assert_eq(IslandBuilder.KEEP_OUT_POINTS[0], POI_PLAYER_START)
	assert_eq(IslandBuilder.KEEP_OUT_POINTS[1], POI_PLANE_WRECKAGE)
	assert_eq(IslandBuilder.KEEP_OUT_POINTS[2], POI_EMERGENCY_SUITCASE)
	assert_eq(IslandZones.BEACON_POSITION, POI_SIGNAL_BEACON)


func test_island_plan_matches_golden() -> void:
	var builder := IslandBuilder.new()
	builder.layout = IslandBuilder.LAYOUT_DEFAULT
	builder.auto_build = false
	add_child_autofree(builder)
	var entries := builder.plan()
	var counts := {}
	var markers := 0
	var positions: Array[Vector2] = []
	for entry in entries:
		positions.append(entry["position"])
		if entry["kind"] == IslandBuilder.KIND_MARKER:
			markers += 1
			continue
		var key := String(entry["definition"].id)
		counts[key] = int(counts.get(key, 0)) + 1
	assert_eq(markers, PLAN_MARKER_COUNT)
	assert_eq(counts.size(), PLAN_COUNTS.size(), "tidak ada definition tak terduga")
	for key in PLAN_COUNTS:
		assert_eq(int(counts.get(key, 0)), int(PLAN_COUNTS[key]), "jumlah %s" % key)
	for index in PLAN_FIRST_POSITIONS.size():
		assert_true(
			positions[index].is_equal_approx(PLAN_FIRST_POSITIONS[index]),
			"posisi #%d: %s != %s" % [index, str(positions[index]), str(PLAN_FIRST_POSITIONS[index])]
		)
