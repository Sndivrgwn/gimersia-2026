duration_hint = "0.12-0.20 s"
bus = 4
priority = 2
file_pattern = "res://assets/audio/ui/ui_pause_off[_1.._2].ogg"
notes = "Termasuk tombol Lanjutkan."

[sub_resource type="Resource" id="Resource_o1wo8"]
script = ExtResource("1_dedpb")
key = &"ui_banner"
