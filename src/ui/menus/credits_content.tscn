[gd_scene format=3]

[ext_resource type="FontFile" path="res://assets/fonts/nunito/Nunito-ExtraBold.ttf" id="1_extrabold"]
[ext_resource type="FontFile" path="res://assets/fonts/nunito/Nunito-Bold.ttf" id="2_bold"]
[ext_resource type="FontFile" path="res://assets/fonts/nunito/Nunito-Regular.ttf" id="3_regular"]

[node name="CreditsContent" type="VBoxContainer"]
custom_minimum_size = Vector2(460, 0)
theme_override_constants/separation = 16

[node name="StudioBlock" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Header" type="Label" parent="StudioBlock"]
layout_mode = 2
theme_override_colors/font_color = Color(0.243, 0.153, 0.102, 1)
theme_override_fonts/font = ExtResource("1_extrabold")
theme_override_font_sizes/font_size = 16
text = "RTRW STUDIO"

[node name="BodyPad" type="MarginContainer" parent="StudioBlock"]
layout_mode = 2
theme_override_constants/margin_left = 14

[node name="StudioDesc" type="Label" parent="StudioBlock/BodyPad"]
layout_mode = 2
theme_override_colors/font_color = Color(0.522, 0.427, 0.357, 1)
theme_override_fonts/font = ExtResource("2_bold")
theme_override_font_sizes/font_size = 17
text = "Dirancang dan dikembangkan oleh RTRW Studio."
autowrap_mode = 3

[node name="EngineBlock" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Header" type="Label" parent="EngineBlock"]
